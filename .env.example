# Copy to .env.local (never commit it). All of these are SERVER-ONLY:
# none is prefixed with NEXT_PUBLIC_, so Next.js never sends them to the browser.

# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Mistral > La Plateforme > API keys
MISTRAL_API_KEY=xxx
# Optional, defaults to mistral-small-latest
# MISTRAL_MODEL=mistral-small-latest

# Any long random string, used to hash visitor IPs for the rate limit.
# Generate one with: openssl rand -hex 32
RATE_LIMIT_SALT=change-me
